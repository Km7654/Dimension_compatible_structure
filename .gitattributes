# Track large binary artifacts with Git LFS if needed
*.zip filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.slx filter=lfs diff=lfs merge=lfs -text
*.mdl filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text

# Keep Jenkins shell scripts compatible with Git Bash and Linux
*.sh text eol=lf
